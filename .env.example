# Microsoft Foundry Configuration
# Copy this file to .env and fill in your values.
#
# The lesson-2 agents use the Microsoft Agent Framework's FoundryChatClient,
# which reads these two variables (env prefix "FOUNDRY_") automatically:

# Your Microsoft Foundry PROJECT endpoint (note: the /api/projects/<project> path)
# Example: https://<your-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment name the agents run on. Use a current (non-retired) model
# such as gpt-5.1, gpt-5-mini, or gpt-5-codex. Do NOT use retired gpt-4o / gpt-4.1.
FOUNDRY_MODEL=gpt-5.1

# ---------------------------------------------------------------------------
# The helper scripts (setup_vector_store.py, lesson-3 evals, lesson-4 deploy)
# use the azure-ai-projects / azure-ai-agents SDKs. They accept the value above
# via FOUNDRY_PROJECT_ENDPOINT, but you can also set the legacy name explicitly:
# AZURE_AI_PROJECT_ENDPOINT=

# Vector Store ID (run `python setup_vector_store.py` first to get this value)
VECTOR_STORE_ID=

# GitHub Personal Access Token (only for the optional task-recommendation agent)
# Create at https://github.com/settings/personal-access-tokens/new
# Required scopes: repo, user
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Lesson 6 (Toolbox): the toolbox CONSUMER MCP endpoint (only for toolbox_agent.py).
# Create a toolbox first, then set this to:
#   https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<name>/mcp?api-version=v1
TOOLBOX_ENDPOINT=

# ---------------------------------------------------------------------------
# Lesson 7 (Agent-to-Agent): host/port the A2A server binds to, and the URL the
# A2A client calls. Defaults work for a local demo; override for remote hosts.
A2A_HOST=localhost
A2A_PORT=9000
A2A_SERVER_URL=http://localhost:9000
