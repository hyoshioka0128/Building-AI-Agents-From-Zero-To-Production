# Microsoft Foundry Configuration
# Get these values from your Microsoft Foundry project

# Required: Microsoft Foundry project endpoint
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Required: Vector store ID for employee directory search
# Create via Microsoft Foundry portal or SDK
VECTOR_STORE_ID=vs_xxxxxxxxxxxxxxxx

# Optional: Model deployment name (defaults to gpt-5.1)
MODEL_DEPLOYMENT=gpt-5.1

# ChatKit Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
DATABASE_PATH=chatkit_onboarding.db

# Hosted Agent Configuration (for ChatKit server to call)
# Must match the deployed hosted agent name (agent.yaml / azure.yaml service name)
HOSTED_AGENT_NAME=dev-onboarding
HOSTED_AGENT_VERSION=1

# Optional: Application Insights for observability
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx
